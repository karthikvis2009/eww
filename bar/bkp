(defvar eww "/sbin/eww -c $HOME/.config/eww/bar")


; Workspace
(deflisten workspaces :initial "[]" "bash ~/.config/eww/bar/scripts/get-workspaces")
(deflisten current_workspace :initial "..." "bash ~/.config/eww/bar/scripts/get-active-workspace")
(deflisten urgent_workspace :initial "..." "bash ~/.config/eww/bar/scripts/get-urgent-workspaces")
(defwidget _workspaces []
  (eventbox :onscroll "bash ~/.config/eww/scripts/change-active-workspace {} ${current_workspace}" :class "workspaces-widget"
    (box :space-evenly false
      (label :text "${workspaces}${current_workspace}${urgent_workspace}" :visible false)
      (for workspace in workspaces
        (eventbox :onclick "hyprctl dispatch workspace ${workspace.id}"
          (box :class "workspace-entry ${workspace.id == current_workspace ? "current" : ""} ${workspace.id == urgent_workspace ? "urgent" : ""} ${workspace.windows > 0 ? "occupied" : "empty" } boxes"
            (label :text "${workspace.id}")
          )
        )
      )
    )
  )
)
;; Status ;;
; (defpoll chargeStatus :interval "5s" "cat /sys/class/power_supply/BAT0/status")
; (defpoll perc :interval "5s" "cat /sys/class/power_supply/BAT0/capacity")
(defpoll cpuGov :interval "5s" "cpupower frequency-info | grep \"The governor\" | awk '{print $3}' | tr -d '\"'")
(defwidget _status []
  (box  :orientation "horizontal"
        :class "statusbox boxes"
        :valign "center"
        :space-evenly "false"
    ; (button :onclick "scripts/status memory"
    ;         :class "memorybutton iconbutton" "")


  (eventbox :onclick "kitty --title btop -o initial_window_width=120 -o initial_window_height=40 -e btop &"
              ; :class "iconbutton membutton"
        ; (image  :path "./iconImages/memory.png")
        (circular-progress    :value "${EWW_RAM.used_mem_perc}"
                              :start-at -90
                              :width 26
                              :height 26
                              :thickness 4
                              :tooltip "${EWW_RAM.used_mem_perc}"
              ; :class "iconbutton membutton"
                              :clockwise "true"
                              :class "memprog ${EWW_RAM.used_mem_perc < 33 ? "low" : 
                                                EWW_RAM.used_mem_perc < 66 ? "med" :
                                                "high"}")
        )


    ;; CPU Button, click to toggle power profile, rightclick to open btop;;
    (eventbox :onclick "scripts/cpu ${cpuGov == "performance" ? "powersave" : "performance"}"
              :space-evenly "false" :valign "center"
        (box :class "cpubutton iconbutton" :space-evenly "false" :valign "center" :halign "center"
        (image :path "${cpuGov == "powersave" ? "./iconImages/cpuPowersave.png" : "./iconImages/cpuPerformance.png"}")
        (progress :class "cpuprog" :value {round(EWW_CPU.avg, 1)} :orientation "horizontal" :valign "center" :halign "center"))
        ; (progress :class "cpuprog" :value ${round(EWW_CPU.avg, 1)} :orientation: "horizontal"))
        )
    (eventbox :onclick "scripts/battery"
        (box :class "batterybutton iconbutton ${EWW_BATTERY.BAT0.status == "Charging" ? "charging" : ""} ${EWW_BATTERY.BAT0.capacity > 70 ? "good" : EWW_BATTERY.BAT0.capacity > 30 ? "ok" : EWW_BATTERY.BAT0.capacity > 10 ? "low" : "critical"}"
              :tooltip "${EWW_BATTERY.BAT0.capacity} %"
          (image :path "${EWW_BATTERY.BAT0.status == "Full" ? "./iconImages/battery7.png" :
                          EWW_BATTERY.BAT0.status == "Charging" ? "./iconImages/battery6.png":
                          EWW_BATTERY.BAT0.capacity > 80 ? "./iconImages/battery5.png":
                          EWW_BATTERY.BAT0.capacity > 60 ? "./iconImages/battery4.png":
                          EWW_BATTERY.BAT0.capacity > 40 ? "./iconImages/battery3.png":
                          EWW_BATTERY.BAT0.capacity > 20 ? "./iconImages/battery2.png": 
                          EWW_BATTERY.BAT0.capacity > 5 ? "./iconImages/battery1.png": "./iconImages/battery0.png"
            }")
          ))
    )
  )


;; Connectivity ;;
; (defpoll eth :interval "1s" "nmcli -f GENERAL.CONNECTION,WIRED-PROPERTIES.CARRIER,GENERAL.STATE,GENERAL.DEVICE device show enp1s0 | head -n 1 | awk '{print $NF}'")
(defpoll wifi :interval "1s" "nmcli -f GENERAL.CONNECTION,WIRED-PROPERTIES.CARRIER,GENERAL.STATE,GENERAL.DEVICE device show wlp2s0 | head -n 1 | awk '{print $NF}'")
(defpoll blue :interval "1s" "scripts/bluetooth")
(defwidget _connectivity []
  (box  :orientation "horizontal"
        :class "connbox boxes"
        :valign "center"
    (eventbox :onclick "kitty --title nmtui -e nmtui &"
              :tooltip "${wifi == "--" ? "Disconnected" : "Connected to ${wifi}"}"
        (image :path "./iconImages/wifiTest.png"))
    (eventbox :onclick "scripts/bluetooth toggle"
              ; :onrightclick "blueman-manager"
              :onrightclick "blueman-manager 2>/tmp/blueman-error.log"
        (box  :class "bluetoothbutton iconbutton ${blue.power == "" ? "off" : "on"}"
              (image  :path "${blue.power ==  "" ? "./iconImages/blueOff.png" :  blue.connected == "YES" ? "./iconImages/blueOn.png" : "./iconImages/blueDiscon.png"}")
          )))
 )

