(defvar volSlider false)
; (defpoll current-vol :interval "1s" "wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print $NF}'")
(defpoll current-vol :interval "1s" "wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print int($NF*100)}'")
(defpoll sinkMute :interval "1s" "wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print $NF}'")
(defpoll sourceMute :interval "1s" "wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | awk '{print $NF}'")

(defwidget _volume []
  (box  :orientation "horizontal"
        ; :class "volumebox boxes"
        :valign "center"
        :space-evenly "false"
        :halign "center"
        :class "boxes"
    ; Mic toggle button
    (eventbox    :onclick "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
                 :onrightclick "pavucontrol 2>/tmp/pavucontrol_error.log"
                 :class "iconbutton"
      (image     :path "${sourceMute == "[MUTED]" ? "./iconImages/micOff.png" : "./iconImages/micOn.png"}"
                 :style "margin: 0px 10px;")
      )
    ;Speaker button + slider
    (box      :valign "center"
              :style "padding: 0px 0px 0px 5px;"
              :space-evenly "false"
    (eventbox    :onclick "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
                 :onhover "${eww} update volSlider=true"
                 :onhoverlost "${eww} update volSlider=false"
                 :onrightclick "pavucontrol 2>/tmp/pavucontrol_error.log"
                 ; :class "iconbutton"

      (box       :valign "center"
                 :space-evenly "false"
                 :class "boxes"
      (image     :path "${sinkMute == "[MUTED]" ? "./iconImages/speakerOff.png" : "./iconImages/speakerOn.png"}")

	(revealer :transition "slideright" 
			  :reveal volSlider
			  :duration "550ms"
              :class "volrevealer"
	(scale    :class "volbar" 	  
              ; :value (int (* current-vol 100))
              :value "${current-vol}"
              :tooltip "${current-vol}"
			  :orientation "horizontal"      
			  :flipped false 
			  :tooltip "Volume: ${current-vol}%" 
			  :max 141
			  :min -1 
			  :onchange "wpctl set-volume @DEFAULT_AUDIO_SINK@ {}%" ))))
      )


    ; (eventbox :onclick "scripts/vol source toggle"
