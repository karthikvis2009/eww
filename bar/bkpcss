.workspace-entry {
  color: rgba(123, 123, 123, 1.0);
  /* padding: 0px 10px; */
  /* margin: 0 2px; */

  border-radius: 6px;
  transition: background 0.5s, color 0.5s;
  background: transparent;

  &.current {
      color: #e1e3e6;
      /* font-weight: bold; */
      border: 2px solid #82aaff;
      background: rgba(12, 75, 56, 0.6);
      /* transition: font-weight 0.5s, border 0.5s, background 0.5s; */
  }

  &.urgent {
      color: #fff;
      animation: urgent-pulse 0.6s alternate infinite;
  }
  
  &.occupied {
      color: rgba(45, 128, 86, 1);
  }

  &.empty {
      color: #6b7089;
      /* opacity: 0.7; */
  }
}


@keyframes urgent-pulse {
  0%   { box-shadow: 0 0 1px #ff5c57; }
  100% { box-shadow: 0 0 2px #ff5c57; }
}

@keyframes crit-bat {
    0% { color: #6b7089; }
    100% { color: #ff5c57; }
}



