/* Volume box*/
.boxes{
  color: #6b7089;
  font-size: 16px;
  /* margin: 0px 2px 0px 2px; */
  margin: 0px 5px 0px 0px;
  padding: 5px 10px 5px 10px;
  border-radius: 6px;
  background: rgba(123,122,212, 0.1);
}


.iconbutton{
      color: #6b7089;
      font-size: 18px;
      font-family: 'JetBrainsMono Nerd Font', monospace;
      /* margin: 0px 2px 0px 2px; */
      margin: 0px 5px 0px 0px;
      padding: 0px 10px 0px 10px;
      border-radius: 6px;
      background: rgba(123,122,212, 0.1);
      
      &.charging{
          background: rgba(29, 152, 110, 0.2);
      }

      &.good{
          color: rgba(45, 128, 86, 0.9);
      }

      &.ok{
          color: rgba(160, 12, 86, 0.5);
      }

      &.low{
          color: rgba(160, 72, 186, 0.5);
      }

      &.critical {
          animation: crit-bat 0.6s alternate infinite;
      }
}

.bluetoothbutton{
        &.off{
            color: #6b7089;
        }
        &.on{
            color: rgba(0, 0, 255, 1.0);
        }
}



