(defvar eww "/sbin/eww -c $HOME/.config/eww/bar")


; Workspace
(deflisten workspaces :initial "[]" "bash ~/.config/eww/bar/scripts/get-workspaces")
(deflisten current_workspace :initial "..." "bash ~/.config/eww/bar/scripts/get-active-workspace")
(deflisten urgent_workspace :initial "..." "bash ~/.config/eww/bar/scripts/get-urgent-workspaces")
(defwidget _workspaces []
  (eventbox :onscroll "bash ~/.config/eww/scripts/change-active-workspace {} ${current_workspace}" :class "workspaces-widget"
    (box :space-evenly false
      (label :text "${workspaces}${current_workspace}${urgent_workspace}" :visible false)
      (for workspace in workspaces
        (eventbox :onclick "hyprctl dispatch workspace ${workspace.id}"
          (box :class "workspace-entry ${workspace.id == current_workspace ? "current" : ""} ${workspace.id == urgent_workspace ? "urgent" : ""} ${workspace.windows > 0 ? "occupied" : "empty" } iconbutton"
            (label :text "${workspace.id}")
          )
        )
      )
    )
  )
)

;; Status ;;
; (defpoll chargeStatus :interval "5s" "cat /sys/class/power_supply/BAT0/status")
; (defpoll perc :interval "5s" "cat /sys/class/power_supply/BAT0/capacity")
(defpoll cpuGov :interval "5s" "cpupower frequency-info | grep \"The governor\" | awk '{print $3}' | tr -d '\"'")
(defwidget _status []
  (box  :orientation "horizontal"
        :class "boxes"
        :valign "center"
        :space-evenly "false"
        :halign "start"
        ; :style "padding: 0px; margin: 5px 0px;"

      (button   :onclick "kitty --title btop -o initial_window_width=120 -o initial_window_height=40 -e btop &"
                :tooltip "${round(EWW_RAM.used_mem_perc,0)}%"
                :class "iconbutton ${EWW_RAM.used_mem_perc > 75 ? "highmem" :
                                     EWW_RAM.used_mem_perc > 20 ? "medmem" :
                                                                  "lowmem" }" ""
                ; :tooltip "${round(EWW_RAM.used_mem_perc, 0)}%"
        )


    ;; CPU Button, click to toggle power profile, rightclick to open btop;;
    (eventbox :onclick "scripts/cpu ${cpuGov == "performance" ? "powersave" : "performance"}"
              :space-evenly "false" :valign "center"
        (box :class "cpubutton iconbutton" :space-evenly "false" :valign "center" :halign "center"
             :style "margin: 0px 5px;"
        (label :class "${cpuGov == "powersave" ? "powersave" : "performance"}"
               :text "")
        (progress :class "cpuprog" :value {round(EWW_CPU.avg, 1)} :orientation "horizontal" :valign "center" :halign "center"))
        )
    (box  :class "iconbutton"
          :space-evenly "false"
          ; :style "background: transparent;"
    (button   :onclick "scripts/battery"
              :tooltip "${EWW_BATTERY.BAT0.capacity} %"
              :class "${EWW_BATTERY.BAT0.status == "Charging" ? "charging" : EWW_BATTERY.BAT0.capacity > 70 ? "good" : EWW_BATTERY.BAT0.capacity > 30 ? "ok" : EWW_BATTERY.BAT0.capacity > 10 ? "low" : "critical"}"
                  "${EWW_BATTERY.BAT0.status == "Full" ? "󱟢" :
                          EWW_BATTERY.BAT0.status == "Charging" ? "󰂄":
                          EWW_BATTERY.BAT0.capacity > 95 ? "󰁹":
                          EWW_BATTERY.BAT0.capacity > 90 ? "󰂂":
                          EWW_BATTERY.BAT0.capacity > 80 ? "󰂁":
                          EWW_BATTERY.BAT0.capacity > 70 ? "󰂀":
                          EWW_BATTERY.BAT0.capacity > 60 ? "󰁿":
                          EWW_BATTERY.BAT0.capacity > 50 ? "󰁾":
                          EWW_BATTERY.BAT0.capacity > 40 ? "󰁽":
                          EWW_BATTERY.BAT0.capacity > 30 ? "󰁼":
                          EWW_BATTERY.BAT0.capacity > 20 ? "󰁻":
                          EWW_BATTERY.BAT0.capacity > 10 ? "󰁺": "󰂃"}"
                        )
      (label    :text "${EWW_BATTERY.BAT0.capacity}%"
                :class "${EWW_BATTERY.BAT0.status == "Charging" ? "charging" : EWW_BATTERY.BAT0.capacity > 70 ? "good" : EWW_BATTERY.BAT0.capacity > 30 ? "ok" : EWW_BATTERY.BAT0.capacity > 10 ? "low" : "critical"}"
                )
      )
    )
  )



;; Connectivity ;;
(defpoll wifi :interval "1s" "nmcli -f GENERAL.CONNECTION,WIRED-PROPERTIES.CARRIER,GENERAL.STATE,GENERAL.DEVICE device show wlp2s0 | head -n 1 | awk '{print $NF}'")
(defpoll blue :interval "1s" "scripts/bluetooth")
(defwidget _connectivity []
  (box  :orientation "horizontal"
        :class "boxes"
        :valign "center"
    (button   :onclick "kitty --title nmtui -e nmtui &"
              :tooltip "${wifi == "--" ? "Disconnected" : "Connected to ${wifi}"}"
              :class "iconbutton ${wifi == "--" ? "wifiDisconnected" : "wifiConnected"}" "${wifi == "--" ? "󰤭" : "󰤨"}")
    (button   :onclick "scripts/bluetooth toggle"
              :onrightclick "blueman-manager 2>/tmp/blueman-error.log"
              :class "iconbutton ${blue.connected == "YES" ? "blueConnected" : "blueDisconnected"}"
              "${blue.power ==  "" ? "󰂲" : "󰂯"}")
          )
 )

;; Media

(defvar volSlider false)
(defpoll current-vol :interval "1s" "wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print int($NF*100)}'")
(defpoll sinkMute :interval "1s" "wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print $NF}'")
(defpoll sourceMute :interval "1s" "wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | awk '{print $NF}'")

(defwidget _volume []
  (box  :orientation "horizontal"
        ; :class "volumebox boxes"
        :valign "center"
        :space-evenly "false"
        :halign "fill"
        :class "boxes"
    ; Mic toggle button
    (button      :onclick "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
                 :onrightclick "pavucontrol 2>/tmp/pavucontrol_error.log"
                 :class "iconbutton ${sourceMute == "[MUTED]" ? "mediaOff" : "mediaOn"}" "${sourceMute == "[MUTED]" ? "󰍭" : "󰍬"}"
      )
    ;Speaker button + slider
    (box      :valign "center"
              ; :style "padding: 0px 0px 0px 5px;"
              :space-evenly "false"
              :class "iconbutton"
    (eventbox    :onclick "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
                 :onhover "${eww} update volSlider=true"
                 :onhoverlost "${eww} update volSlider=false"
                 :onrightclick "pavucontrol 2>/tmp/pavucontrol_error.log"

      (box       :valign "center"
                 :space-evenly "false"

        (label    :text "${sinkMute == "[MUTED]" ? "󰖁" : "󰕾"}"
                  :class "${sinkMute == "[MUTED]" ? "mediaOff" : "mediaOn"}")
	(revealer :transition "slideright" 
			  :reveal volSlider
			  :duration "550ms"
	(scale    :class "volbar" 	  
              ; :value (int (* current-vol 100))
              :value "${current-vol}"
              :tooltip "${current-vol}"
			  :orientation "horizontal"      
			  :flipped false 
			  :tooltip "Volume: ${current-vol}%" 
			  :max 141
			  :min -1 
			  :onchange "wpctl set-volume @DEFAULT_AUDIO_SINK@ {}%" ))))
      )
    )
)

;; Date Widget ;;
(defwidget _date []
    (box    :class "boxes"
            :style "background: transparent; margin: 5px 0px 5px 5px; padding: 0px;"
	(button	:onclick "if [ -z '$(pgrep calcurse)' ]; then kitty --title calcurse -r calcurse; else pkill calcurse; fi"	
			:class "date iconbutton" "${date} (${day})")))
(defpoll date	:interval "1s"	"date '+%b %d'")
(defpoll day	:interval "1s"	"date '+%a'")


;; Clock Widget ;;
(defwidget _clock []
    (box    :class "boxes"
            :style "background: transparent; margin: 5px 0px 5px 0px; padding: 0px;"
	(button	:onclick "scripts/popup calendar"	
			:class "time-hour-min iconbutton" "${hour}:${min}")))
(defpoll hour	:interval "1s"	"date '+%H'")
(defpoll min	:interval "1s"	"date '+%M'")

(defwindow bar
  :monitor 0
  :geometry (geometry :x "0.5%" :y "0.1%" :width "99%" :height "20px" :anchor "top center")
  :stacking "overlay"
  :reserve (struts :distance "12px" :side "top")
  :windowtype "dock"
  :wm-ignore false
  :exclusive true
  (box :orientation "horizontal" :halign "fill" :valign "center"
    ;; Left section for future widgets
    (box :halign "start" :valign "center" :space-evenly "false" :class "bar-section-left"
      (_volume)
      (_connectivity)
    )
    ;; Center section for workspaces
    (box :halign "center" :valign "center" :class "bar-section-center"
      (_workspaces)
    )
    ;; Right section for clock and others
    (box  :halign "end" :valign "center" :space-evenly "false" :class "bar-section-right"
      (_status)
      (_date)
      (_clock)
    )
  )
)
