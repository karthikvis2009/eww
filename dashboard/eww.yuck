;; ** Variables ***********************************************************************

;; Profile vars
(defvar IMAGE "images/self.jpg")
(defvar NAME "Karthik Viswanathan")
(defpoll UNAME :interval "15m" `whoami`)

;; System vars
(defpoll CPU_USAGE :interval "1s" `scripts/sys_info --cpu`)
(defpoll MEM_USAGE :interval "1s" `scripts/sys_info --mem`)
(defpoll BRT :interval "1s" `scripts/sys_info --brt`)
(defpoll BATTERY :interval "5s" `scripts/sys_info --bat`)

;; Time vars
(defpoll HOUR :interval "5s" `date +\"%I\"`)
(defpoll MIN :interval "5s" `date +\"%M\"`)
(defpoll MER :interval "5s" `date +\"%p\"`)
(defpoll DAY :interval "5s" `date +\"%A\"`)

;;  Calendar vars

(defpoll CURRENTYEAR :interval "1m" "date +'%Y'")
(defpoll CURRENTMONTH :interval "1m" "date +'%m'")
(defpoll CURRENTDAY :interval "1m" "date +'%d'")

;; Uptime vars
(defpoll UPHOUR :interval "5s" `uptime -p | awk '{print $2 \" \" $3}' | sed 's/,//g'`)
(defpoll UPMIN :interval "5s" `uptime -p | awk '{print $4 \" \" $5}'`)

;; volCtrl vars
(defpoll volLvl :interval "15s" `scripts/volCtrl --vol get`)
(defpoll micLvl :interval "15s" `scripts/volCtrl --mic get`)

;; Files vars
(defpoll FREE :interval "5s" `df -h / | awk '{print $4}' | tail -n 1 | sed 's/G/GB/'`)


;; ** Widgets *************************************************************************


;; background
(defwidget bg [] 
	(box :class "bg")
)

;; profile
(defwidget user [] 
	(box :class "genwin" :orientation "v" :spacing 35 :space-evenly "false" :vexpand "false" :hexpand "false"
		(box :style "background-image: url('${IMAGE}');" :class "face" :halign "center")
		(label :class "fullname" :halign "center" :wrap "true" :limit-width 25 :text NAME)
		(label :class "username" :halign "center" :wrap "true" :limit-width 25 :text UNAME)))

;; system
(defwidget system [] 
	(box :class "genwin" :vexpand "false" :hexpand "false" 
      (eventbox  :onclick "eww close-all && xdotool key Super+p"
		(box :orientation "v" :spacing 35 :halign "center" :valign "center" :space-evenly "false" :vexpand "false" :hexpand "false" 
			(box :class "cpu_bar" :orientation "h" :spacing 20 :space-evenly "false" :vexpand "false" :hexpand "false" 
				(label :class "iconcpu" :text "")
				(scale :min 0 :max 100 :value CPU_USAGE :active "false"))
			(box :class "mem_bar" :orientation "h" :spacing 20 :space-evenly "false" :vexpand "false" :hexpand "false" 
				(label :class "iconmem" :text "")
				(scale :min 0 :max 100 :value MEM_USAGE :active "false"))
			(box :class "bright_bar" :orientation "h" :spacing 20 :space-evenly "false" :vexpand "false" :hexpand "false" 
				(label :class "iconbright" :text "󰃞 ")
				(scale :min 0 :max 100 :value BRT :active "false"))
			(box :class "bat_bar" :orientation "h" :spacing 20 :space-evenly "false" :vexpand "false" :hexpand "false" 
				(label :class "iconbat" :text "")
				(scale :min 0 :max 100 :value BATTERY :active "false"))))))

;; clock
(defwidget clock [] 
	(box :class "genwin" :orientation "h" :spacing 50 :space-evenly false :vexpand "false" :hexpand "false" 
		(box :orientation "h" :spacing 0
			(label :class "time_hour" :valign "start" :wrap "true" :limit-width 25 :text HOUR)
			(label :class "time_min" :valign "end" :wrap "true" :limit-width 25 :text MIN))
		(box :orientation "v" :spacing 0 
			(label :class "time_mer" :valign "start" :halign "end" :wrap "true" :limit-width 25 :text MER)
			(label :class "time_day" :valign "end" :halign "end" :wrap "true" :limit-width 25 :text DAY))))

;; uptime
(defwidget uptime [] 
	(box :class "genwin" 
		(box :orientation "h" :halign "center" :spacing 40 :space-evenly "false" :vexpand "false" :hexpand "false" 
			(label :class "icontimer" :valign "center" :text " ")
			(box :orientation "v" :valign "center" :spacing 0 :space-evenly "false" :vexpand "false" :hexpand "false" 
				(label :class "uphour" :halign "start" :wrap "true" :limit-width 25 :text UPHOUR)
				(label :class "upmin" :halign "start" :wrap "true" :limit-width 25 :text UPMIN)))))

;; volCtrl
(defwidget volCtrl [] 
  (box :class "genwin" :orientation "v" :spacing 10 :space-evenly "true"
    ;; Microphone Control
    (box :orientation "h" :spacing 10 :space-evenly "false" :vexpand "false" :hexpand "false" 
      (button :class "volIcon" :onclick "scripts/volCtrl --mic mute" "󰍬")
      (scale :class "volScale" :orientation "h" :value micLvl :min 0 :max 100
             :onchange "scripts/volCtrl --mic {}"))

    (box :orientation "h" :spacing 10 :space-evenly "false" :vexpand "false" :hexpand "false" 
      (button :class "volIcon" :onclick "scripts/volCtrl --vol mute" "󰕾")
      (scale :class "volScale" :orientation "h" :value volLvl :min 0 :max 100
             :onchange "scripts/volCtrl --vol {}"))
    (box :orientation "h" :spacing 10 :space-evenly "true" :vexpand "false" :hexpand "false"
      (button :class "pavuIcon" :onclick "eww close-all && pavucontrol &" "󰝚")
      (button :class "btIcon" :onclick "eww close-all && xdotool key XF86AudioMicMute" "󰂯")
      (button :class "wifiIcon" :onclick "eww close-all && xdotool key Super+w" "󰖩")
      (button :class "sysIcon" :onclick "eww close-all && xdotool key Super+p" ""))))


;; Calendar
(defwidget cal[] 
	(eventbox :class "genwin" :vexpand "false" :hexpand "false"
              :onrightclick "eww close-all && xdotool key Super+m"
      (calendar :class "cal" :month "${CURRENTMONTH}" :year "${CURRENTYEAR}" :day "${CURRENTDAY}")))

;; github
(defwidget github [] 
	(box :class "github" :vexpand "false" :hexpand "false" 
		(button :class "iconweb" :onclick "scripts/open_links --gh" "")))

