;; apps
(defwidget apps [] 
	(box :class "genwin" :orientation "v" :space-evenly "false" :vexpand "false" :hexpand "false" 
		(box :class "appbox" :orientation "h" :space-evenly "false" :vexpand "false" :hexpand "false" 
			(button :class "app_freecad" :onclick "scripts/open_apps --fc" "")
			(button :class "app_paraview" :onclick "scripts/open_apps --pv" "󰰚")
			(button :class "app_blender" :onclick "scripts/open_apps --bl" ""))
		(box :class "appbox" :orientation "h" :space-evenly "false" :vexpand "false" :hexpand "false" 
			(button :class "app_zotero" :onclick "scripts/open_apps --zo" "")
			(button :class "app_discord" :onclick "scripts/open_apps --dc" "")
			(button :class "app_gimp" :onclick "scripts/open_apps --gp" ""))
		(box :class "appbox" :orientation "h" :space-evenly "false" :vexpand "false" :hexpand "false" 
			(button :class "app_thunderbird" :onclick "scripts/open_apps --tb" "")
			(button :class "app_brave" :onclick "scripts/open_apps --br" "")
			(button :class "app_kitty" :onclick "scripts/open_apps --kt" "󰄛"))))

;; power buttons
(defwidget logout [] 
	(box :class "genwin" :vexpand "false" :hexpand "false" 
		(button :class "btn_logout" :onclick "pkill dwm" "󰍃")))
(defwidget lock [] 
	(box :class "genwin" :vexpand "false" :hexpand "false" 
		(button :class "btn_lock" :onclick "slock" " ")))
(defwidget reboot [] 
	(box :class "genwin" :vexpand "false" :hexpand "false" 
		(button :class "btn_reboot" :onclick "reboot" " ")))
(defwidget poweroff [] 
	(box :class "genwin" :vexpand "false" :hexpand "false" 
		(button :class "btn_poweroff" :onclick "shutdown now" " ")))

;; folders
(defwidget folders [] 
	(box :class "genwin" :orientation "v" :space-evenly "false" :vexpand "false" :hexpand "false" 
		(box :class "hddbox" :orientation "h" :space-evenly "false" :vexpand "false" :hexpand "false" 
			(box :space-evenly "false" :vexpand "false" :hexpand "false"
				(button :class "hddicon" :onclick "scripts/open_apps --fm" "")
				(label :class "fs_sep" :text "|"))
			(box :space-evenly "false" :vexpand "false" :hexpand "false" 
				(label :class "hdd_label" :wrap "true" :limit-width 25 :text FREE)))
		(box :orientation "h" :space-evenly "false" :vexpand "false" :hexpand "false" 
			(button :class "iconfolder1" :onclick "scripts/open_folders --docs th" "")
			(button :class "label_folder1" :onclick "scripts/open_folders --docs kt" "Documents"))
		(box :orientation "h" :space-evenly "false" :vexpand "false" :hexpand "false" 
			(button :class "iconfolder2" :onclick "scripts/open_folders --dl th" "")
			(button :class "label_folder2" :onclick "scripts/open_folders --dl kt" "Downloads"))
		(box :orientation "h" :space-evenly "false" :vexpand "false" :hexpand "false" 
			(button :class "iconfolder3" :onclick "scripts/open_folders --ofcases th" "")
			(button :class "label_folder3" :onclick "scripts/open_folders --ofcases kt" "OFCases"))
		(box :orientation "h" :space-evenly "false" :vexpand "false" :hexpand "false" 
			(button :class "iconfolder4" :onclick "scripts/open_folders --pics th" "")
			(button :class "label_folder4" :onclick "scripts/open_folders --pics kt" "Pictures"))
		(box :orientation "h" :space-evenly "false" :vexpand "false" :hexpand "false" 
			(button :class "iconfolder5" :onclick "scripts/open_folders --web th" "󰖟")
			(button :class "label_folder5" :onclick "scripts/open_folders --web kt" "Website"))
		(box :orientation "h" :space-evenly "false" :vexpand "false" :hexpand "false" 
			(button :class "iconfolder6" :onclick "scripts/open_folders --cfg th" "")
			(button :class "label_folder6" :onclick "scripts/open_folders --cfg kt" "~/.config"))))


